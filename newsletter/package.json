{
  "name": "batjaa-newsletter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "email dev --dir templates/emails -p 3001",
    "preview": "npm run dev",
    "build": "tsx scripts/build.ts",
    "build:issue": "tsx scripts/build.ts --issue",
    "test": "tsx --test tests/*.test.ts",
    "send:test": "tsx scripts/send.ts --test",
    "send:broadcast": "tsx scripts/send.ts --broadcast",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.10",
    "marked": "^18.2.0",
    "postmark": "^5.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.11",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@react-email/ui": "^6.11.11",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
